<div class="card{{#featured}} featured{{/featured}}">
    {{#featured}}<span class="card-badge">Featured</span>{{/featured}}
    <div class="meta">
        <time datetime="{{publication.iso8601}}">{{publication.date.long}}</time>
        {{#contents.readingTime}} &middot; <span class="reading-time">{{.}} min read</span>{{/contents.readingTime}}
    </div>

    <h2 class="title"><a href="{{permalink}}">{{title}}</a></h2>
    <p class="card-description">{{description}}</p>

    <div class="tag-list">
    {{#tags}}
        <a href="{{permalink}}"><small>{{title}}</small></a>
    {{/tags}}
    </div>
    <div class="post-byline">
    {{#authors}}
        <a href="{{permalink}}">
            {{#image}}<img class="author-avatar" src="{{.}}" alt="">{{/image}}
            <span>{{title}}</span>
        </a>
    {{/authors}}
    </div>
</div>
